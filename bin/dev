#!/usr/bin/env bash
# Launch the local stats dashboard Flask app on :5000.
#
# Reverse-proxy is handled by the system Caddy in `it-management`
# (configs/caddy/demo.Caddyfile, listening on :9999). With that running, the
# dashboard is reachable at:
#
#   - http://localhost:5000        (direct, no path prefix)
#   - http://localhost:9999/nplol/ (via Caddy on this Mac)
#   - https://localwork.vongohren.me/nplol/  (via Cloudflare tunnel + Caddy)
#
# Caddy status:    brew services list | grep caddy
# Reload Caddy:    caddy reload --config /opt/homebrew/etc/Caddyfile
#
# Requirements:
#   - src/env virtualenv with flask installed:
#       cd src && source env/bin/activate && pip install -r requirements-web.txt

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SRC_DIR="$REPO_ROOT/src"
VENV_PY="$SRC_DIR/env/bin/python"

if [ ! -x "$VENV_PY" ]; then
  echo "error: $VENV_PY not found. Set up the venv per src/README.md first." >&2
  exit 1
fi

echo "[dev] starting Flask on :5000"
echo "[dev] direct: http://localhost:5000"
echo "[dev] caddy:  http://localhost:9999/nplol/  (system Caddy from it-management)"
cd "$SRC_DIR"
exec "$VENV_PY" -m web.app

#!/usr/bin/env bash
# Launch the local stats dashboard Flask app on http://localhost:5000.
#
# This script only handles the Flask process. If you want the dashboard
# behind a reverse proxy under a path prefix, that's outside this repo —
# the proxy just needs to forward `X-Forwarded-Prefix: <prefix>` and
# Flask's ProxyFix handles the rest. See docs/DASHBOARD.md.
#
# Requirements:
#   src/env virtualenv with flask installed:
#     cd src && source env/bin/activate && pip install -r requirements-web.txt

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SRC_DIR="$REPO_ROOT/src"
VENV_PY="$SRC_DIR/env/bin/python"

if [ ! -x "$VENV_PY" ]; then
  echo "error: $VENV_PY not found. Set up the venv per src/README.md first." >&2
  exit 1
fi

echo "[dev] http://localhost:5000"
cd "$SRC_DIR"
exec "$VENV_PY" -m web.app
